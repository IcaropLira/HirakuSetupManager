{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hiraku Setup Manager",
  "mainBinaryName": "hiraku-setup-manager",
  "version": "0.1.0",
  "identifier": "com.hiraku.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hiraku Setup Manager",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Instala e configura kitty, tmux, Vim/Neovim e o shell",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/hiraku": "linux/hiraku"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/hiraku": "linux/hiraku"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzNUZFOTJBMTc4QjZBQTgKUldTb2Fvc1hLdWxmVTRhZCsrV1hzT09ueWRkc1h1amlYWjAzWFFzZzR2SGVKWCtENlZtcGFDT2cK",
      "endpoints": [
        "https://github.com/IcaropLira/HirakuSetupManager/releases/latest/download/latest.json"
      ]
    }
  }
}
